# OpenRAL open deploy image — x86_64 + CUDA 13 + ROS 2 Jazzy. NO GStreamer.
#
# THE open-repo deploy image (`openral:x86`). Builds the full open (non-Pro)
# OpenRAL deploy graph — every colcon ROS package + the C++ safety kernel + the
# full Python workspace — with NO GStreamer, PyGObject/`gi`, DeepStream, NVMM,
# or TensorRT. `openral deploy run` takes camera frames through the open
# `opencv_thread` sensor backend (cv2.VideoCapture over V4L2/USB), and runs the
# object detector + Robometer reward monitor as plain ROS-topic consumers (both
# are gstreamer-free: `ros_image_detector_node` / `reward_monitor_node` subscribe
# to `/openral/cameras/<name>/image`; the detector auto-selects its CPU-ONNX /
# zeroshot tier when `gst-inspect-1.0`/`nvinfer` is absent).
#
# The proprietary media stack — GStreamer + the NVMM zero-copy fast path +
# DeepStream + TensorRT — is **OpenRAL Pro**. openral-pro's `docker/Dockerfile.pro`
# `FROM`s this image and installs that whole stack itself (it no longer inherits
# GStreamer from this base). The GStreamer `SensorReader`/perception-tee is still
# available in-repo as the opt-in `gstreamer` extra (PyGObject), but it is NOT in
# this image.
#
# The CUDA-13 runtime base is kept so torch/onnxruntime use the GPU; pass
# `--gpus all` at run time. For a strict CPU-only image, swap the two
# `nvidia/cuda:13.0.0-*-ubuntu24.04` bases for `ubuntu:24.04` (onnxruntime is
# already installed below; torch's CPU wheels resolve via uv).
#
# ── Build ────────────────────────────────────────────────────────────
#
#   just docker-build-x86          # → openral:x86
#   # or: docker buildx build -f docker/inference/Dockerfile.x86 -t openral:x86 .
#
# ── Run (real SO-101 bench, opencv cameras) ──────────────────────────
#
#   docker run --rm --gpus all --network host \
#       --device /dev/ttyACM0 \
#       --device /dev/video0 --device /dev/video4 \
#       -v /dev/v4l:/dev/v4l:ro \
#       -v "$(pwd)/scenes:/workspace/scenes:ro" \
#       -v "$(pwd)/rskills:/workspace/rskills:ro" \
#       -v "$(pwd)/robots:/workspace/robots:ro" \
#       openral:x86 \
#       deploy run --config scenes/deploy/so101_bench.yaml
#
# The entrypoint is the bare `openral` CLI (see the final stage), so the
# pre-deploy setup commands work the same way:
#
#   docker run --rm openral:x86 doctor
#   docker run --rm --device /dev/ttyACM0 openral:x86 detect
#
# `deploy run` is real-hardware only: a DeployScene under `scenes/deploy/`
# (with `opencv_thread` camera bindings) + a connected robot are required.
# `--network host` is recommended so the host can share the DDS bus. ROS 2
# Jazzy + the local colcon overlay are sourced by the entrypoint.

# ── Stage 1: builder ─────────────────────────────────────────────────

FROM nvidia/cuda:13.0.0-cudnn-runtime-ubuntu24.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG ROS_DISTRO=jazzy

# Add the ROS 2 apt repo (Jazzy on Ubuntu 24.04 = noble).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg2 lsb-release software-properties-common \
    && add-apt-repository universe \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
        > /etc/apt/sources.list.d/ros2.list

# System deps for: building Python wheels (build-essential), Python headers for
# source-built transitive deps, curl for the uv installer, ROS 2 Jazzy ros-base
# + sensor-msgs + rclpy + cyclonedds rmw, and the toolchain to `colcon build`
# the in-tree ROS packages under `packages/` + the C++ safety kernel and
# opentelemetry vendor under `cpp/`. NO gstreamer/gi/cairo — this image never
# constructs a GStreamer pipeline (cameras use the opencv_thread backend).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        git \
        pkg-config \
        # Python headers for evdev + other source builds.
        python3-dev \
        # ROS 2 Jazzy ros-base (no -desktop; we don't need rviz / demos).
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-sensor-msgs \
        ros-${ROS_DISTRO}-rclpy \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        # colcon + ament harness for building packages/ + cpp/ in-tree.
        python3-colcon-common-extensions \
        python3-vcstool \
        ros-${ROS_DISTRO}-ament-cmake \
        ros-${ROS_DISTRO}-ament-cmake-python \
        ros-${ROS_DISTRO}-ament-lint-auto \
        ros-${ROS_DISTRO}-ament-lint-common \
        ros-${ROS_DISTRO}-lifecycle-msgs \
        ros-${ROS_DISTRO}-launch-ros \
        ros-${ROS_DISTRO}-launch-testing \
        ros-${ROS_DISTRO}-launch-testing-ros \
        ros-${ROS_DISTRO}-rosidl-default-generators \
        ros-${ROS_DISTRO}-rosidl-default-runtime \
        # Wrapped-ROS rSkills + lifecycle peers (moveit joints skill + demo).
        ros-${ROS_DISTRO}-moveit \
        ros-${ROS_DISTRO}-moveit-msgs \
        ros-${ROS_DISTRO}-moveit-resources-panda-moveit-config \
        # nav2 + slam_toolbox + nav-msgs: the ros_action nav skill + the
        # Reasoner-managed SLAM background service (only used by lidar/mobile
        # robots; harmless when the scene leaves enable_slam/enable_nav2 off).
        ros-${ROS_DISTRO}-nav2-bringup \
        ros-${ROS_DISTRO}-nav2-msgs \
        ros-${ROS_DISTRO}-slam-toolbox \
        ros-${ROS_DISTRO}-nav-msgs \
        # OctoMap build deps for openral_octomap_bridge (octree→OccupancyVoxels
        # feeding the C++ safety kernel's voxel check).
        ros-${ROS_DISTRO}-octomap \
        ros-${ROS_DISTRO}-octomap-msgs \
        ros-${ROS_DISTRO}-tf2-geometry-msgs \
        # C++ safety kernel + opentelemetry_cpp_vendor build deps. The vendor
        # package builds opentelemetry-cpp from source; the kernel links its
        # CMake targets. abseil is transitive via protobuf but pinned for a
        # deterministic build.
        libprotobuf-dev \
        protobuf-compiler \
        libabsl-dev \
        libssl-dev \
        libcurl4-openssl-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# uv installs to /usr/local/bin so it's on the default PATH.
RUN curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh

WORKDIR /workspace

# Copy workspace metadata + lockfile first so dep resolution is layer-cacheable.
COPY pyproject.toml uv.lock ./
COPY python/ python/

# Workspace install. Groups needed for a real VLA deploy with the perception
# legs, all gstreamer-free:
#   sim   — the lerobot / transformers / accelerate / bitsandbytes stack the VLA
#           policy adapters AND the in-process Robometer reward monitor import at
#           load time (needed on REAL hardware too).
#   omdet — the open-vocabulary object detector (omdet-turbo, transformers-based)
#           the ros_image_detector_node runs when enable_object_detector is on.
#   lingbot — the msgpack + synchronous-websocket protocol dependencies used by
#           the out-of-process LingBot policy adapters, including Galaxea A1.
# The `opencv_thread` camera path needs cv2 (opencv-python). It is a per-member
# EXTRA (openral-runner `opencv`), NOT pulled by `uv sync --all-packages`, so it
# is installed explicitly post-sync alongside onnxruntime (which lives only in
# the `dev` group; needed for the detector's CPU-ONNX / RT-DETR fallback tier and
# any `runtime: onnx` rSkill). The `gstreamer`/PyGObject extra is intentionally
# NOT installed. feetech-servo-sdk + deepdiff (the SO-100/101 real servo bus)
# arrive automatically via openral-hal's `lerobot[feetech]` base dep — already in
# uv.lock. TensorRT (`--group tensorrt`) is an OpenRAL Pro plugin — never here.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --all-packages \
        --group sim --group omdet --group lingbot \
    && uv pip install --python /workspace/.venv/bin/python onnxruntime opencv-python

# Copy the colcon-buildable trees AFTER the venv resolve so a packages/ tweak
# doesn't bust the (much larger) Python dep layer. `cpp/` carries the C++ safety
# kernel + the opentelemetry_cpp_vendor package the kernel links against.
COPY packages/ packages/
COPY cpp/ cpp/

# Bake the manifest trees so `openral doctor` / `deploy run` work out of the box.
COPY robots/ robots/
COPY rskills/ rskills/
COPY benchmarks/ benchmarks/
# tools/ carries the launch's autostart driver (tools/lifecycle_autostart.py) +
# the Robometer reward sidecar; scenes/ carries the committed DeployScene
# workcells so `deploy run --config scenes/deploy/*.yaml` needs no bind-mount.
COPY tools/ tools/
COPY scenes/ scenes/

# Build every ROS 2 + C++ package the deploy image needs in one shot. The set
# mirrors `just ros2-build` so the on-host dev loop and the image stay aligned —
# including openral_perception_ros (the gstreamer-free ros_image_detector_node +
# reward_monitor_node) and the C++ safety kernel (binary lands at
# /workspace/install/lib/openral_safety_kernel/safety_kernel_node).
#
# `Python3_EXECUTABLE=/workspace/.venv/bin/python` is essential so the
# ament-python packages resolve openral_* + structlog against the venv, not the
# unconfigured system python. `--merge-install` collapses the trees into one
# `/workspace/install/setup.bash`; `--symlink-install` is dropped because the
# runtime stage copies install/ over and cross-tree symlinks would dangle.
RUN bash -lc 'set -eo pipefail \
    && source /opt/ros/${ROS_DISTRO}/setup.bash \
    && set -u \
    && colcon build --merge-install \
        --base-paths packages cpp \
        --packages-select openral_msgs \
                          opentelemetry_cpp_vendor \
                          openral_hal_so100 \
                          openral_hal_galaxea_a1 \
                          openral_hal_openarm \
                          openral_world_state \
                          openral_reasoner_ros \
                          openral_prompt_router \
                          openral_safety \
                          openral_safety_watchdog \
                          openral_safety_kernel \
                          openral_human_estop \
                          openral_foxglove_bringup \
                          openral_rskill_ros \
                          openral_octomap_bridge \
                          openral_perception_ros \
        --cmake-args -DPython3_EXECUTABLE=/workspace/.venv/bin/python \
                     -DCMAKE_C_COMPILER=/usr/bin/gcc \
                     -DCMAKE_CXX_COMPILER=/usr/bin/g++ \
                     -DCMAKE_BUILD_TYPE=Release \
    && rm -rf build log'

# The launch resolves its _REPO_ROOT as parents[3] of the installed
# sim_e2e.launch.py — i.e. /workspace/install — and from there looks up
# tools/lifecycle_autostart.py, rskills/, scenes/, and .venv/bin/openral.
# colcon does not install the non-ROS trees, so link them into install/.
RUN ln -sfn /workspace/tools   /workspace/install/tools \
    && ln -sfn /workspace/rskills /workspace/install/rskills \
    && ln -sfn /workspace/scenes  /workspace/install/scenes \
    && ln -sfn /workspace/.venv   /workspace/install/.venv

# ── Stage 2: runtime-base ────────────────────────────────────────────

FROM nvidia/cuda:13.0.0-runtime-ubuntu24.04 AS runtime-base

ARG DEBIAN_FRONTEND=noninteractive
ARG ROS_DISTRO=jazzy

# Re-add the ROS apt repo for the runtime layer (only runtime libs). `git` is a
# RUNTIME dep: the Robometer reward sidecar provisions its own pinned venv on
# first use with `uv pip install <robometer git URL>`.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg2 lsb-release software-properties-common git \
    && add-apt-repository universe \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
        > /etc/apt/sources.list.d/ros2.list

# Runtime libs only — NO gstreamer/gi/cairo.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-sensor-msgs \
        ros-${ROS_DISTRO}-rclpy \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        ros-${ROS_DISTRO}-lifecycle-msgs \
        ros-${ROS_DISTRO}-launch-ros \
        ros-${ROS_DISTRO}-rosidl-default-runtime \
        # Wrapped-ROS rSkills + lifecycle-peer runtime deps.
        ros-${ROS_DISTRO}-moveit \
        ros-${ROS_DISTRO}-moveit-msgs \
        ros-${ROS_DISTRO}-moveit-resources-panda-moveit-config \
        ros-${ROS_DISTRO}-nav2-bringup \
        ros-${ROS_DISTRO}-nav2-msgs \
        ros-${ROS_DISTRO}-slam-toolbox \
        ros-${ROS_DISTRO}-nav-msgs \
        # OctoMap runtime libs the openral_octomap_bridge node links at start.
        ros-${ROS_DISTRO}-octomap \
        ros-${ROS_DISTRO}-octomap-msgs \
        ros-${ROS_DISTRO}-octomap-server \
        ros-${ROS_DISTRO}-tf2-geometry-msgs \
        # Foxglove dashboard — the exec_depends of openral_foxglove_bringup,
        # which the builder stage colcon-builds (see --packages-select below).
        # The package builds fine without them and then dies at launch on a
        # missing executable, so `deploy run` with the dashboard enabled failed
        # in this image. image-transport / joint-state-publisher arrive
        # transitively via moveit today; listed together as one package's
        # declared contract rather than relying on that.
        ros-${ROS_DISTRO}-foxglove-bridge \
        ros-${ROS_DISTRO}-image-transport \
        ros-${ROS_DISTRO}-compressed-image-transport \
        ros-${ROS_DISTRO}-joint-state-publisher \
        # Runtime libs the C++ safety kernel + opentelemetry-cpp pull at start.
        # Versioned names on noble: libabsl20220623t64, libprotobuf32t64.
        libabsl20220623t64 \
        libprotobuf32t64 \
        libssl3 \
        libcurl4 \
        lttng-tools python3-lttngust babeltrace2 \
        # opencv-python (the opencv_thread camera backend) dlopen's libGL and
        # libgthread at `import cv2`; without them it raises
        # `ImportError: libGL.so.1: cannot open shared object file` in a headless
        # container. These are plain graphics/threading libs — NOT gstreamer.
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Carry the resolved venv + workspace + colcon install/ from the builder.
COPY --from=builder /workspace /workspace
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv

# LTTng opt-in: splice the distro's python3-lttngust (2.13.x, the only working
# Python 3.12 build) into the venv so openral_observability.tracing_lttng picks
# it up instead of the JSONL tracer. (No gi splice here — this image has no gi.)
RUN ln -sfT /usr/lib/python3/dist-packages/lttngust \
    /workspace/.venv/lib/python3.12/site-packages/lttngust

# Shared entrypoint — probes /opt/ros/*/setup.bash + /workspace/install/setup.bash
# and sources the first match before exec'ing the CMD. Media-stack-agnostic.
COPY docker/inference/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PATH=/workspace/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    ROS_DISTRO=${ROS_DISTRO} \
    # Cyclonedds is the default rmw: Fast DDS' SHM transport interacts badly
    # with pydantic v2's Rust core (rclpy.init()/Node() SIGSEGV after pydantic
    # has run in the same process). Cyclone uses its own DDS impl and is
    # unaffected. Override at run-time with -e RMW_IMPLEMENTATION=...
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    # Default ROS_DOMAIN_ID=0; override at run-time with -e ROS_DOMAIN_ID=N.
    ROS_DOMAIN_ID=0

# ── Final stage ──────────────────────────────────────────────────────
#
# The final image is `runtime-base` as-is: CUDA 13 runtime + ROS Jazzy +
# workspace venv + entrypoint, with NO GStreamer, NO DeepStream, NO TensorRT,
# NO NVMM. Cameras run through opencv_thread; inference through pytorch/onnxruntime.
# openral-pro's `Dockerfile.pro` FROMs this image and installs the proprietary
# media stack (GStreamer + DeepStream + NVMM + TensorRT) itself.

FROM runtime-base AS final

WORKDIR /workspace

# Entrypoint is the bare `openral` CLI, not a hardcoded `deploy run`:
# deploying on real hardware starts with `doctor` / `detect` / calibration
# checks before the first `deploy run`, and hardcoding the subcommand made
# every one of those unreachable without --entrypoint gymnastics.
#
#   docker run --rm img doctor                                # host diagnosis
#   docker run --rm --device /dev/ttyACM0 img detect          # robot.yaml wizard
#   docker run --rm --gpus all ... img deploy run --config scenes/deploy/so101_bench.yaml
#
# Default CMD shows the deploy help so a bare `docker run img` still lands on
# the image's primary purpose.
ENTRYPOINT ["/entrypoint.sh", "openral"]
CMD ["deploy", "run", "--help"]

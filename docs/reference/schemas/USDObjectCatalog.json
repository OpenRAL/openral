{
  "$defs": {
    "BoxShape": {
      "additionalProperties": false,
      "description": "Oriented box (OBB) collision primitive \u2014 a rectangular convex block.\n\nAn axis-aligned box in the primitive's local frame (placed and oriented by\nthe owning frame's ``origin_xyz_rpy`` / ``pose``), spanning\n``[-half_extents_m[k], +half_extents_m[k]]`` along each local axis ``k``.\n\nA box fits a *blocky* link (a near-cubic housing, e.g. the SO-ARM100/101\n``base``) far tighter than a capsule: a capsule's circular cross-section\nmust bulge past the block's flat faces, so it over-reports clearance at\nposes where the flat faces are what actually face a neighbour. That bulge\nis what makes the manifest capsule model false-E-stop the SO-101 at its\nhome pose (base\u2194lower_arm / base\u2194wrist reported penetrating while the true\nmesh clearance is +0.16 m / +0.24 m). See issue #84.\n\nAttributes:\n    shape: Discriminator (always ``\"box\"``).\n    half_extents_m: Half-sizes ``(hx, hy, hz)`` along the local x/y/z axes\n        in metres (the full box is ``2*hx x 2*hy x 2*hz``).\n\nExample:\n    >>> BoxShape(half_extents_m=(0.055, 0.048, 0.036)).shape\n    'box'",
      "properties": {
        "shape": {
          "const": "box",
          "default": "box",
          "title": "Shape",
          "type": "string"
        },
        "half_extents_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Half Extents M",
          "type": "array"
        }
      },
      "required": [
        "half_extents_m"
      ],
      "title": "BoxShape",
      "type": "object"
    },
    "CapsuleShape": {
      "additionalProperties": false,
      "description": "Capsule collision primitive \u2014 a segment swept by a radius.\n\nThe central segment runs along the local +Z axis from ``-length_m / 2``\nto ``+length_m / 2`` (the MJCF / URDF capsule convention); it is placed\nand oriented by the owning frame (``LinkCollisionGeometry.origin_xyz_rpy``\nfor a link, ``AttachedCollisionPrimitive.pose_in_object`` for a payload).\nCapsules bound most robot links tightly, so the safety check stays\nconservative.\n\nAttributes:\n    shape: Discriminator (always ``\"capsule\"``).\n    radius_m: Capsule radius in metres.\n    length_m: Length of the central segment in metres (the cylinder\n        portion; the total span is ``length_m + 2 * radius_m``). ``0.0``\n        degenerates to a sphere.\n\nExample:\n    >>> CapsuleShape(radius_m=0.04, length_m=0.3).length_m\n    0.3",
      "properties": {
        "shape": {
          "const": "capsule",
          "default": "capsule",
          "title": "Shape",
          "type": "string"
        },
        "radius_m": {
          "exclusiveMinimum": 0.0,
          "title": "Radius M",
          "type": "number"
        },
        "length_m": {
          "minimum": 0.0,
          "title": "Length M",
          "type": "number"
        }
      },
      "required": [
        "radius_m",
        "length_m"
      ],
      "title": "CapsuleShape",
      "type": "object"
    },
    "CatalogMeasurementCalibration": {
      "additionalProperties": false,
      "description": "Externally established error bound for attributed object surface measurements.\n\nThe bound must cover depth, extrinsics and point attribution/outliers. Declaring\nit is not calibration proof; the referenced calibration must exist independently.\nNo defaults establish a physical bound, sensor support or freshness policy.",
      "properties": {
        "point_error_bound_m": {
          "minimum": 0.0,
          "title": "Point Error Bound M",
          "type": "number"
        },
        "calibration_reference": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Calibration Reference",
          "type": "string"
        },
        "sensor_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Sensor Ids",
          "type": "array"
        },
        "max_age_s": {
          "exclusiveMinimum": 0.0,
          "title": "Max Age S",
          "type": "number"
        }
      },
      "required": [
        "point_error_bound_m",
        "calibration_reference",
        "sensor_ids",
        "max_age_s"
      ],
      "title": "CatalogMeasurementCalibration",
      "type": "object"
    },
    "SphereShape": {
      "additionalProperties": false,
      "description": "Sphere collision primitive \u2014 the simplest convex link/obstacle volume.\n\nAttributes:\n    shape: Discriminator (always ``\"sphere\"``).\n    radius_m: Sphere radius in metres.\n\nExample:\n    >>> SphereShape(radius_m=0.05).shape\n    'sphere'",
      "properties": {
        "shape": {
          "const": "sphere",
          "default": "sphere",
          "title": "Shape",
          "type": "string"
        },
        "radius_m": {
          "exclusiveMinimum": 0.0,
          "title": "Radius M",
          "type": "number"
        }
      },
      "required": [
        "radius_m"
      ],
      "title": "SphereShape",
      "type": "object"
    },
    "USDDeclaredObject": {
      "additionalProperties": false,
      "description": "Catalog identity and optional object-local authored shape for one USD prim.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "prim_path": {
          "pattern": "^/(?:[A-Za-z_][A-Za-z0-9_]*/)*[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Prim Path",
          "type": "string"
        },
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "shape": {
          "anyOf": [
            {
              "$ref": "#/$defs/USDObjectPrimitive"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workspace_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Workspace Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "prim_path",
        "label"
      ],
      "title": "USDDeclaredObject",
      "type": "object"
    },
    "USDDeclaredWorkspace": {
      "additionalProperties": false,
      "description": "Authored box workspace in the catalog's named USD stage frame.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "prim_path": {
          "pattern": "^/(?:[A-Za-z_][A-Za-z0-9_]*/)*[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Prim Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "search",
            "workspace"
          ],
          "title": "Role",
          "type": "string"
        },
        "location": {
          "enum": [
            "fixed",
            "movable"
          ],
          "title": "Location",
          "type": "string"
        },
        "shape": {
          "$ref": "#/$defs/BoxShape"
        },
        "pose_in_stage": {
          "$ref": "#/$defs/USDLocalPose"
        }
      },
      "required": [
        "name",
        "prim_path",
        "role",
        "location",
        "shape"
      ],
      "title": "USDDeclaredWorkspace",
      "type": "object"
    },
    "USDLocalPose": {
      "additionalProperties": false,
      "description": "Authored transform in a USD object-local or stage frame.",
      "properties": {
        "xyz_m": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Xyz M",
          "type": "array"
        },
        "quat_xyzw": {
          "default": [
            0.0,
            0.0,
            0.0,
            1.0
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Quat Xyzw",
          "type": "array"
        }
      },
      "title": "USDLocalPose",
      "type": "object"
    },
    "USDObjectPrimitive": {
      "additionalProperties": false,
      "description": "Authored analytic solid in an object's local frame; never read from live xforms.",
      "properties": {
        "shape": {
          "discriminator": {
            "mapping": {
              "box": "#/$defs/BoxShape",
              "capsule": "#/$defs/CapsuleShape",
              "sphere": "#/$defs/SphereShape"
            },
            "propertyName": "shape"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CapsuleShape"
            },
            {
              "$ref": "#/$defs/SphereShape"
            },
            {
              "$ref": "#/$defs/BoxShape"
            }
          ],
          "title": "Shape"
        },
        "dimension_semantics": {
          "enum": [
            "nominal",
            "maximum"
          ],
          "title": "Dimension Semantics",
          "type": "string"
        },
        "pose_in_object": {
          "$ref": "#/$defs/USDLocalPose"
        }
      },
      "required": [
        "shape",
        "dimension_semantics"
      ],
      "title": "USDObjectPrimitive",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Validated OpenRAL records read from external USD customData.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_revision": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "units": {
      "const": "m",
      "title": "Units",
      "type": "string"
    },
    "stage_frame_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Stage Frame Id",
      "type": "string"
    },
    "measurement_calibration": {
      "anyOf": [
        {
          "$ref": "#/$defs/CatalogMeasurementCalibration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "objects": {
      "default": [],
      "items": {
        "$ref": "#/$defs/USDDeclaredObject"
      },
      "maxItems": 512,
      "title": "Objects",
      "type": "array"
    },
    "workspaces": {
      "default": [],
      "items": {
        "$ref": "#/$defs/USDDeclaredWorkspace"
      },
      "maxItems": 64,
      "title": "Workspaces",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "source_revision",
    "units",
    "stage_frame_id"
  ],
  "title": "USDObjectCatalog",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

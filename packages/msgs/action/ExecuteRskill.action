# Goal — invoke an rSkill
string rskill_id            # e.g. "openral/skill-pick-cube-so100"
string revision            # HF Hub revision (sha or tag); empty = latest pinned
string prompt              # natural-language instruction
string prompt_metadata_json # serialized SkillPrompt metadata (Pydantic)
string goal_params_json    # per-skill structured parameters
                            #   (serialized JSON object); empty = disabled.
                            #   Wrapped-ROS skills deep-merge over
                            #   ros_integration.default_goal_json at
                            #   configure-time; VLAs ignore.
float64 deadline_s         # 0 = use manifest default

# Optional place-phase declaration (ADR-0097), additive and defaulted off.
# False — every pre-ADR-0097 caller — means no place witness may ever arm for
# this goal, which is exactly today's behaviour. True declares that this goal
# places its payload into place_declaration.target_id, permitting (never
# causing) a place-phase SupportContactWitness for measured contact ON that
# target. The runner scopes the declaration to this goal's lifetime: it
# publishes it on accept and retracts it on success, failure, cancel, and
# E-stop, and the declaration's own timeout_s expires it if the runner dies.
bool place_declaration_valid
PlaceDeclaration place_declaration

# Optional grasp-phase declaration (real pick-and-place design §2.1), additive
# and defaulted off. The runner strips any region (dispatch never measures),
# publishes it on accept and retracts it on success, failure, cancel and E-stop.
bool grasp_declaration_valid
GraspDeclaration grasp_declaration
---
# Result
bool success
string failure_reason      # empty on success
string trace_id            # OTel trace id for replay

# failure_kind — typed cause mirroring the CLAUDE.md §5 exception hierarchy, for
# machine consumers (the reasoner's replanning ladder) to classify on instead of
# substring-matching `failure_reason`.
# Additive (CLAUDE.md §1.6): a consumer reading only success/failure_reason is
# unaffected; an older producer's Result decodes as FAILURE_NONE, which on
# success=False consumers must treat as "unknown", not "succeeded".
# Producer: `rskill_runner_node._execute_locked`. ROSSafetyViolation (other than
# ROSEStopRequested) is absent — re-raised to the safety supervisor, never
# folded into a Result.
uint8 FAILURE_NONE                = 0    # success
uint8 FAILURE_CONFIG_ERROR        = 1    # ROSConfigError
uint8 FAILURE_CAPABILITY_MISMATCH = 2    # ROSCapabilityMismatch
uint8 FAILURE_RUNTIME_ERROR       = 3    # ROSRuntimeError (+Quantization/GPUMemory)
uint8 FAILURE_SAFETY_ESTOP        = 4    # ROSEStopRequested
uint8 FAILURE_PERCEPTION_STALE    = 5    # ROSPerceptionStale
uint8 FAILURE_PLANNING_ERROR      = 6    # ROSPlanningError (MoveIt approach)
uint8 FAILURE_DEADLINE_MISSED     = 7    # execution budget lapsed / ROSDeadlineMissed
uint8 FAILURE_CANCELLED           = 8    # cancel honoured (no exception)
uint8 FAILURE_OBJECT_NOT_FOUND    = 9    # ROSObjectNotInMemory: the goal's object search was exhausted (issue #418)
uint8 FAILURE_UNKNOWN             = 255  # untyped non-ROSError escape
uint8 failure_kind

# evidence_json — the typed detail behind failure_kind: one
# `openral_core.FailureEvidence` variant (decode with
# `TypeAdapter(FailureEvidence).validate_json`). Empty on success and when the
# failure has no structured detail beyond failure_reason (a cancel, a config or
# runtime fault). Producer: `rskill_runner_node._attach_failure_evidence`:
#   FAILURE_SAFETY_ESTOP      the newest /openral/failure/safety report: the kernel's
#                             (CollisionEvidence, ...), the operator / hardware e-stop's
#                             (HumanEvidence) or the deadman's (TimeoutEvidence); empty
#                             when no publisher explained the stop
#   FAILURE_PERCEPTION_STALE  PerceptionStaleEvidence (which kernel input, its age,
#                             the limit) when a stale input stalled the action
#   FAILURE_DEADLINE_MISSED   TimeoutEvidence (budget vs elapsed)
#   FAILURE_OBJECT_NOT_FOUND  ObjectQueryEvidence (the exhausted query)
# Additive (CLAUDE.md §1.6): an older producer's Result decodes as "".
string evidence_json
---
# Feedback
float32 progress           # 0..1
string state               # "loading"|"warming"|"executing"|"replanning"|"recovering"
uint32 chunk_index
uint32 chunks_total

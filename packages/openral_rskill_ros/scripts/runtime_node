#!/usr/bin/env python3
r"""F1 — composed-runtime entry point.

Brings up ``world_state_node`` + ``rskill_runner_node`` in a single OS
process with one shared :class:`WorldStateAggregator`.
The robot's on-disk ``robot.yaml`` is selected via a ROS parameter:

.. code-block:: bash

    ros2 run openral_rskill_ros runtime_node --ros-args \\
        -p robot_yaml:=/abs/path/to/robots/<id>/robot.yaml

Production launches (``so100_e2e.launch.py``, ``openarm_e2e.launch.py``,
…) spawn one ``Node(executable="runtime_node", parameters=[{"robot_yaml": …}])``
each — the per-robot launch picks the YAML; everything else is identical.

This is the entry point referenced by CLAUDE.md §1.11: real
``RobotDescription`` loaded from the in-tree manifest, no placeholders.
"""

from __future__ import annotations

import sys

# ── gi/Gst FIRST — before numpy/pydantic/rclpy ───────────────────────
# The real-camera sensor leg (``deploy_config`` param) opens GStreamer
# readers in this process. Under Fast-DDS (the launch default), a later
# ``rclpy.Node()`` SIGSEGVs inside ``_rclpy.Node`` whenever numpy or
# pydantic were imported before ``gi`` + ``Gst.init()`` — bisected
# empirically on x86 Ubuntu 24.04 (system PyGObject 3.48 / GStreamer
# 1.24 / ROS Jazzy; SO-101 deploy bring-up 2026-07-02; Cyclone DDS is
# unaffected). These MUST therefore be the first imports in the process,
# ahead of every openral module (whose import chains pull numpy).
# Deliberately NOT ``import openral_runner...reader`` — its package
# ``__init__`` imports numpy first, defeating the ordering. Best-effort:
# hosts without PyGObject skip cleanly, and the leg then fails loudly at
# open time only if a gstreamer sensor is actually configured.
try:
    import gi

    gi.require_version("Gst", "1.0")
    from gi.repository import Gst  # reason: gi requires version-pin before import

    Gst.init(None)
except ImportError:
    pass


def _prewarm_vla_imports() -> None:
    """Import the shared VLA framework stack while no camera thread exists.

    On a real deploy the lazy per-goal VLA import inside this process is
    crushed by the camera reader threads: ``transformers``' import runs
    ``importlib.metadata.packages_distributions()`` — a stat() per file of
    every installed distribution — and every stat releases the GIL, which a
    30 fps reader thread then snatches. Measured live on an SO-101 bench:
    the identical import chain takes 23 s in a quiet process and 8+ minutes
    (unfinished) once two camera readers are up; neither bytecode
    precompilation nor a raised GIL switch interval rescues it, because the
    convoy is on GIL *re-acquisition* after each syscall, not on compute
    slices. So pay the 23 s exactly once here, single-threaded, before
    ``open_deploy_sensor_readers`` spawns the first reader — the per-goal
    import then hits ``sys.modules`` and completes in milliseconds.

    **The call must stay ahead of ``open_deploy_sensor_readers``.** That
    ordering is the entire fix; moving it after the readers reinstates the
    8-minute stall. It is the same class of ordering constraint as the
    ``gi``/``Gst.init()`` block at the top of this file.

    Also runs on the sim path, where there are no in-process reader threads
    and so no convoy: there the point is to overlap ~7 s of import with the
    HAL's concurrent ``on_configure`` instead of charging it to the first
    ``ExecuteRskill`` goal.

    Best-effort: hosts without the VLA stack (slim installs) skip cleanly;
    the per-goal lazy import still raises its own typed error.
    """
    from openral_rskill._diagnostics import phase_timer

    try:
        with phase_timer("vla_framework", prefix="prewarm"):
            import torch  # noqa: F401  # reason: prewarm only

            # Pulls transformers (the packages_distributions stat storm) and
            # every lerobot policy family module — the shared ~95% of any
            # VLA adapter's import phase.
            from lerobot.policies import factory  # noqa: F401  # reason: prewarm only
    except ImportError:
        pass


def _main() -> int:  # noqa: PLR0911, PLR0912, PLR0915  # reason: linear bootstrap entry point — splitting obscures the launch contract
    try:
        import rclpy
        from rclpy.executors import ExternalShutdownException, MultiThreadedExecutor
        from rclpy.parameter import Parameter
    except ImportError as exc:
        print(
            f"runtime_node: rclpy not on PYTHONPATH ({exc}); source install/setup.bash first.",
            file=sys.stderr,
        )
        return 1

    from openral_observability import configure_observability
    from openral_observability.system_metrics import start_system_metrics_collector
    from openral_rskill_ros.compose import compose_runtime

    # Idempotent + no-op if OTEL_EXPORTER_OTLP_ENDPOINT is unset.
    # The launch passes the dashboard's endpoint via env so the
    # `runtime.tick` / `rskill.execute` spans land on the live UI.
    configure_observability(service_name="openral.runtime")
    # Feed the dashboard's System Health card. No-ops cleanly on hosts
    # without psutil / pynvml — the card simply stays empty there.
    start_system_metrics_collector(interval_s=1.0)

    rclpy.init()

    # Bootstrap a tiny throwaway node just to read the launch-supplied
    # parameters. Avoids requiring the caller to set env vars; matches
    # how the safety kernel reads ``envelope_file``.
    bootstrap = rclpy.create_node("openral_runtime_bootstrap")
    bootstrap.declare_parameter("robot_yaml", "")
    bootstrap.declare_parameter("rskill_search_paths", [""])
    bootstrap.declare_parameter("camera_names", [""])
    # Forwarded to the composed RskillRunnerNode's
    # ``reset_to_pose_service`` parameter so the runner calls the
    # HAL's ResetToPose service with the manifest's starting_pose
    # before the first inference tick. Empty disables the call.
    bootstrap.declare_parameter("reset_to_pose_service", "")
    # Render the octomap occupied-voxel cloud
    # (``/octomap_point_cloud_centers``) into the dashboard's
    # ``world.pointcloud`` span family. Off by default; the
    # ``sim_e2e.launch.py`` flips this on when ``enable_octomap:=true``
    # so the robot-view pointcloud card populates as octomap_server runs.
    bootstrap.declare_parameter("enable_world_cloud_bridge", False)
    # PointCloud2 topic the world-cloud bridge renders into world.pointcloud.
    # Empty → octomap's /octomap_point_cloud_centers default; a visual-SLAM
    # deploy sets it to nvblox's ESDF voxel cloud.
    bootstrap.declare_parameter("world_cloud_topic", "")
    # Node name the dashboard SLAM card credits for /map. Empty → the
    # openral_slam_toolbox default; the visual-SLAM launch sets
    # openral_nvblox when nvblox builds the map.
    bootstrap.declare_parameter("slam_source_node", "")
    # Record the deploy session (proprio + action + camera frames
    # + episode markers) to a rosbag2 mcap. Empty disables recording; the
    # ``openral deploy sim/run --dataset-out`` flag sets it via the launch.
    bootstrap.declare_parameter("dataset_out", "")
    bootstrap.declare_parameter("dataset_repo_id", "")
    bootstrap.declare_parameter("dataset_license", "CC-BY-4.0")
    # Real deploys only (`openral deploy run --config …`): path to the
    # DeployScene YAML. When set, the runtime opens one SensorReader per
    # deploy-bound SensorSpec (robot manifest ∪ scene `sensors:`) and
    # publishes each camera onto `/openral/cameras/<name>/image` (the
    # WorldState subscription) — the real-hardware counterpart of the sim
    # HAL's SimSensorBridge.
    # Empty (sim deploys) leaves the HAL bridge as the only camera source.
    bootstrap.declare_parameter("deploy_config", "")
    robot_yaml: str = bootstrap.get_parameter("robot_yaml").get_parameter_value().string_value
    search_paths: list[str] = [
        p
        for p in bootstrap.get_parameter("rskill_search_paths")
        .get_parameter_value()
        .string_array_value
        if p
    ]
    # Forwarded to the skill resolver so the policy adapter sees the
    # scene's actual camera keys (rskill's ImagePreprocessing.aliases
    # then remaps them to the checkpoint's observation.images.* names).
    camera_names: list[str] = [
        c
        for c in bootstrap.get_parameter("camera_names").get_parameter_value().string_array_value
        if c
    ]
    reset_to_pose_service: str = (
        bootstrap.get_parameter("reset_to_pose_service").get_parameter_value().string_value
    )
    enable_world_cloud_bridge: bool = (
        bootstrap.get_parameter("enable_world_cloud_bridge").get_parameter_value().bool_value
    )
    world_cloud_topic: str = (
        bootstrap.get_parameter("world_cloud_topic").get_parameter_value().string_value
    )
    slam_source_node: str = (
        bootstrap.get_parameter("slam_source_node").get_parameter_value().string_value
    )
    dataset_out: str = bootstrap.get_parameter("dataset_out").get_parameter_value().string_value
    dataset_repo_id: str = (
        bootstrap.get_parameter("dataset_repo_id").get_parameter_value().string_value
    )
    dataset_license: str = (
        bootstrap.get_parameter("dataset_license").get_parameter_value().string_value
    )
    deploy_config: str = bootstrap.get_parameter("deploy_config").get_parameter_value().string_value
    bootstrap.destroy_node()

    if not robot_yaml:
        print(
            "runtime_node: required ROS parameter `robot_yaml` is empty; "
            "pass `-p robot_yaml:=/abs/path/to/robots/<id>/robot.yaml` "
            "(launches resolve this from LaunchConfiguration).",
            file=sys.stderr,
        )
        rclpy.try_shutdown()
        return 2

    # Build the production resolver. ``make_default_skill_resolver``
    # branches on ``manifest.kind`` so wrapped-ROS skills
    # (``kind: ros_action`` / ``ros_service``) get an
    # :class:`ROSActionRskill` against the host node, while VLA
    # manifests fall through to the local-tree path (same search
    # paths as the reasoner's palette seed). The local-only resolver
    # always calls ``_build_runtime_skill_from_manifest`` which
    # rejects non-VLA kinds, so using it directly here makes the
    # reasoner-dispatched wrapped-ROS skills (nav2, moveit,
    # look-at) fail at goal-execute time with ``kind='ros_action' is
    # not a VLA policy``.
    #
    # ``compose_runtime`` constructs the host
    # :class:`RskillRunnerNode`, so we hand it a resolver factory
    # signature that closes over the node once the node is built.
    # See ``compose.py`` / ``rskill_runner_node.py:700`` for the
    # production wiring.
    from openral_rskill_ros.rskill_runner_node import make_default_skill_resolver

    def _build_resolver(skill_runner_node: object) -> object:
        # Wire a lazy ``tf_lookup_getter`` so the resolver
        # reads ``skill_runner_node._tf_lookup`` AT DISPATCH TIME rather
        # than at factory time. ``_init_tf_lookup`` runs in
        # ``on_configure`` which fires AFTER this factory is invoked
        # from ``compose_runtime.__init__``; without the lazy getter the
        # resolver would close over ``None`` and the wrapped-task-space
        # state assembler would silently fall back to the raw 11-D
        # joint-state slice, surfacing as ``rldx adapter expects a
        # 16-D state for state_layout='rc365', got 11-D``.
        return make_default_skill_resolver(
            skill_runner_node,
            search_paths=search_paths,
            scene_cameras=camera_names,
            tf_lookup_getter=lambda: getattr(skill_runner_node, "_tf_lookup", None),
        )

    try:
        runtime = compose_runtime(
            robot_yaml,
            skill_resolver_factory=_build_resolver,
            enable_world_cloud_bridge=enable_world_cloud_bridge,
            world_cloud_topic=world_cloud_topic,
            slam_source_node=slam_source_node,
            dataset_out=dataset_out or None,
            dataset_repo_id=dataset_repo_id or None,
            dataset_license=dataset_license or "CC-BY-4.0",
        )
    except Exception as exc:  # surface as exit code, not stack trace
        print(f"runtime_node: compose_runtime failed: {exc!s}", file=sys.stderr)
        rclpy.try_shutdown()
        return 3

    # Pre-warm the heavy VLA imports BEFORE the first camera reader thread
    # exists (see _prewarm_vla_imports — the readers' GIL churn stretches the
    # same import from 23 s to 8+ min). Emits
    # prewarm_vla_framework_{start,heartbeat,done} so the operator sees the
    # one-time bring-up cost.
    #
    # Runs on the SIM path too, even though sim spawns no in-process reader
    # threads and so has no convoy to avoid. The win there is different: the
    # import is ~7 s of pure single-threaded work that the first
    # ``ExecuteRskill`` goal used to pay in the operator's critical path,
    # whereas here it overlaps the HAL's own ``on_configure`` (~6 s on a
    # MuJoCo arm, ~27 s on a cold robocasa kitchen) happening concurrently in
    # another process. Same total work, moved off the goal.
    _prewarm_vla_imports()

    # Real deploys: open the deploy config's camera readers and publish
    # them onto the WorldState image topics. Fail loudly — a real run
    # whose cameras cannot open would otherwise starve the policy of
    # images and fold blind (same failure class the safety-kernel
    # autostart guards against).
    sensor_leg = None
    if deploy_config:
        from openral_core import DeployScene
        from openral_rskill_ros.sensor_leg import (
            merge_deploy_sensors,
            open_deploy_sensor_readers,
            slam_camera_names,
            topic_frame_size,
        )

        try:
            scene = DeployScene.from_yaml(deploy_config)
            # Robot-manifest ∪ scene sensors (scene wins on name collision —
            # a same-named scene entry is that robot sensor's deploy binding);
            # the leg opens only those carrying a `deploy_binding`. The shared
            # aggregator gets frames straight from the readers (the
            # zero-copy vision path — zero-copy NVMM handles survive; no intra-process ROS
            # round trip on the policy leg).
            # Visual SLAM tracks frame-to-frame motion and loses the track on
            # a starved stream, so its cameras are exempted from the fallback
            # publisher's rate cap automatically — derived from the scene, not
            # from a per-binding flag somebody has to remember (§1.4).
            sensor_leg = open_deploy_sensor_readers(
                merge_deploy_sensors(runtime.description.sensors, scene.sensors),
                aggregator=runtime.aggregator,
                ros_node=runtime.world_state_node,
                uncapped_sensors=slam_camera_names(scene.runtime),
                topic_max_size=topic_frame_size(scene.runtime),
            )
            if sensor_leg.direct_sensors:
                from rclpy.parameter import Parameter

                runtime.world_state_node.set_parameters(
                    [
                        Parameter(
                            "direct_image_frame_sensors",
                            Parameter.Type.STRING_ARRAY,
                            list(sensor_leg.direct_sensors),
                        )
                    ],
                )
        except Exception as exc:  # surface as exit code, not stack trace
            print(f"runtime_node: sensor leg failed to open: {exc!s}", file=sys.stderr)
            rclpy.try_shutdown()
            return 6

    # Forward the optional reset-service name from the bootstrap to
    # the composed lifecycle node. ``RskillRunnerNode`` declared the
    # parameter at construction; this just overrides the empty
    # default before lifecycle transitions fire.
    if reset_to_pose_service:
        from rclpy.parameter import Parameter

        runtime.skill_runner_node.set_parameters(
            [Parameter("reset_to_pose_service", Parameter.Type.STRING, reset_to_pose_service)],
        )

    executor = MultiThreadedExecutor(num_threads=4)
    executor.add_node(runtime.world_state_node)
    executor.add_node(runtime.skill_runner_node)

    # Drive the two internal lifecycle nodes to ACTIVE automatically.
    # `runtime_node` is the launch-side entry point — there is no
    # external lifecycle manager that would otherwise issue the
    # transitions, so the demo would sit forever in "unconfigured".
    # On configure / activate failure we surface a non-zero exit and
    # log the cause instead of spinning silently.
    from rclpy.lifecycle import TransitionCallbackReturn

    for node in (runtime.world_state_node, runtime.skill_runner_node):
        rc = node.trigger_configure()
        if rc != TransitionCallbackReturn.SUCCESS:
            print(
                f"runtime_node: {node.get_name()}.trigger_configure returned {rc!r}",
                file=sys.stderr,
            )
            rclpy.try_shutdown()
            return 4
        rc = node.trigger_activate()
        if rc != TransitionCallbackReturn.SUCCESS:
            print(
                f"runtime_node: {node.get_name()}.trigger_activate returned {rc!r}",
                file=sys.stderr,
            )
            rclpy.try_shutdown()
            return 5

    # Start camera publication only after both composed lifecycle nodes have
    # created all ROS entities. Concurrent publishing during runner configure
    # can block rclpy entity creation before the ExecuteRskill server exists.
    if sensor_leg is not None:
        try:
            sensor_leg.start()
        except Exception as exc:  # surface as exit code, not stack trace
            print(f"runtime_node: sensor leg failed to start: {exc!s}", file=sys.stderr)
            rclpy.try_shutdown()
            return 6

    try:
        executor.spin()
    except (KeyboardInterrupt, ExternalShutdownException):
        # Normal teardown path. rclpy installs a SIGINT handler at
        # `rclpy.init()` that shuts down the context AND raises
        # KeyboardInterrupt out of `executor.spin()` on Jazzy. On
        # ROS 2 Rolling / a manual `rclpy.shutdown()` from another
        # thread, the executor instead raises ExternalShutdownException.
        # Either way the context is already shut down by the time we
        # reach the `finally` below, so the bare `rclpy.shutdown()`
        # we used to call there raised
        # `RCLError: rcl_shutdown already called` — the
        # `try_shutdown()` switch below is the corresponding fix.
        pass
    finally:
        # Close the real-camera leg first: its publishers poll the readers,
        # and the readers hold v4l2 / GStreamer pipeline handles.
        if sensor_leg is not None:
            sensor_leg.close()
        # Finalize the recorded bag (drains the writer thread,
        # closes any open episode) BEFORE the nodes go down.
        if runtime.dataset_recorder_bridge is not None:
            runtime.dataset_recorder_bridge.destroy()
        runtime.skill_runner_node.destroy_node()
        runtime.world_state_node.destroy_node()
        # Idempotent — no-op when the SIGINT handler (or whoever fired
        # ExternalShutdownException) already shut down the context.
        rclpy.try_shutdown()
    return 0


if __name__ == "__main__":
    raise SystemExit(_main())

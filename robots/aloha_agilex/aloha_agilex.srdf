<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-written exemptions for the aloha_agilex kernel self-collision ACM (openral#740).
     Source: OpenRAL, not a vendor MoveIt config; `openral collision lower` unions these
     rows into the adjacent / certified-always-colliding pairs it derives itself.
     Every row here is a safety-WG review item. -->
<robot name="aloha_agilex">
  <!-- The rear arms (lr_*, rr_*) are welded at q = 0 in the deploy twin (manifest
       `fixed_attachments` *_weld rows): every pair below is rigid, its relative pose can
       never change, and its fitted capsules overlap at that pose. The tool cannot prove
       them always-colliding because the URDF still declares those joints revolute. Any
       pair touching a moving (front-arm) link stays checked. -->
  <disable_collisions link1="lr_link2" link2="lr_link4" reason="User"/>
  <disable_collisions link1="lr_link2" link2="lr_link5" reason="User"/>
  <disable_collisions link1="lr_link4" link2="lr_link6" reason="User"/>
  <disable_collisions link1="lr_link5" link2="lr_link7" reason="User"/>
  <disable_collisions link1="rr_link2" link2="rr_link4" reason="User"/>
  <disable_collisions link1="rr_link2" link2="rr_link5" reason="User"/>
  <disable_collisions link1="rr_link4" link2="rr_link6" reason="User"/>
  <disable_collisions link1="rr_link5" link2="rr_link7" reason="User"/>
</robot>

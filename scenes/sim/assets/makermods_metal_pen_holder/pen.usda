#usda 1.0
(
    defaultPrim = "pen"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "pen" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.015
    int physxRigidBody:solverPositionIterationCount = 32
    int physxRigidBody:solverVelocityIterationCount = 4
    def Material "Barrel"
    {
        token outputs:surface.connect = </pen/Barrel/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.0009, 0.0009, 0.0011)
            float inputs:roughness = 0.15
            float inputs:metallic = 0
            token outputs:surface
        }
    }
    def Material "Label"
    {
        token outputs:surface.connect = </pen/Label/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </pen/Label/Tex.outputs:rgb>
            float inputs:roughness = 0.4
            float inputs:metallic = 0
            token outputs:surface
        }
        def Shader "Tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/pen_label.png@
            token inputs:sourceColorSpace = "sRGB"
            float4 inputs:scale = (1.0, 1.0, 1.0, 1)
            float2 inputs:st.connect = </pen/Label/St.outputs:result>
            float3 outputs:rgb
        }
        def Shader "St"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
    def Cube "collider" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 2
        uniform token purpose = "guide"
        double3 xformOp:translate = (0.000000, 0.000000, 0.000000)
        quatf xformOp:orient = (1.000000, 0.000000, 0.000000, 0.000000)
        float3 xformOp:scale = (0.076500, 0.010000, 0.010000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        rel material:binding:physics = </pen/PhysicsMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
    }
    def Cylinder "barrel" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.153
        double radius = 0.01
        rel material:binding = </pen/Barrel>
    }

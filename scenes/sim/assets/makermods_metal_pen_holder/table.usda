#usda 1.0
(
    defaultPrim = "table"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "table"
{
    def Material "Desk"
    {
        token outputs:surface.connect = </table/Desk/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </table/Desk/Tex.outputs:rgb>
            float inputs:roughness = 0.35
            float inputs:metallic = 0
            token outputs:surface
        }
        def Shader "Tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/desk_baked.jpg@
            token inputs:sourceColorSpace = "sRGB"
            float4 inputs:scale = (0.84, 0.84, 0.84, 1)
            float2 inputs:st.connect = </table/Desk/St.outputs:result>
            float3 outputs:rgb
        }
        def Shader "St"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
    def Material "ShelfTop"
    {
        token outputs:surface.connect = </table/ShelfTop/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </table/ShelfTop/Tex.outputs:rgb>
            float inputs:roughness = 0.5
            float inputs:metallic = 0
            token outputs:surface
        }
        def Shader "Tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @textures/shelf_top.jpg@
            token inputs:sourceColorSpace = "sRGB"
            float4 inputs:scale = (1.0, 1.0, 1.0, 1)
            float2 inputs:st.connect = </table/ShelfTop/St.outputs:result>
            float3 outputs:rgb
        }
        def Shader "St"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
    def Material "ShelfSide"
    {
        token outputs:surface.connect = </table/ShelfSide/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.0397, 0.0301, 0.0196)
            float inputs:roughness = 0.6
            float inputs:metallic = 0
            token outputs:surface
        }
    }
    def Material "Wall"
    {
        token outputs:surface.connect = </table/Wall/Shader.outputs:surface>
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.6846, 0.6846, 0.665)
            float inputs:roughness = 0.9
            float inputs:metallic = 0
            token outputs:surface
        }
    }
    def Cube "desk" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 2
        double3 xformOp:translate = (0.125000, 0.265000, -0.012500)
        quatf xformOp:orient = (1.000000, 0.000000, 0.000000, 0.000000)
        float3 xformOp:scale = (0.475000, 0.735000, 0.012500)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        rel material:binding = </table/Desk>
        rel material:binding:physics = </table/PhysicsMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
    }
    def Mesh "desk_top" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [3,3]
        int[] faceVertexIndices = [0,3,2,0,2,1]
        point3f[] points = [(-0.3500,-0.4700,0.0005),(-0.3500,1.0000,0.0005),(0.6000,1.0000,0.0005),(0.6000,-0.4700,0.0005)]
        texCoord2f[] primvars:st = [(0.00000, 0.00000), (0.00000, 1.00000), (1.00000, 1.00000), (0.00000, 0.00000), (1.00000, 1.00000), (1.00000, 0.00000)] (
            interpolation = "faceVarying"
        )
        uniform token subdivisionScheme = "none"
        rel material:binding = </table/Desk>
    }
    def Cube "shelf" (

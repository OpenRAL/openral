# Source requirements for the LocateAnything-3B sidecar venv (Python 3.12).
# transformers==4.57.1 is the load-bearing pin (mirrors the nvidia/LocateAnything
# Space requirements.txt); the rest are its known-good companions + ZMQ/msgpack
# wire deps. Regenerate the lock with:
#   uv pip compile tools/sidecar_requirements/locateanything.in \
#     --universal --torch-backend=cu128 --generate-hashes --python-version 3.12 \
#     --overrides tools/sidecar_requirements/aarch64-nvrtc-override.txt \
#     -o tools/sidecar_requirements/locateanything.lock
# The --overrides file raises nvrtc past the sm_121 cliff on aarch64 (GB10 /
# Jetson Thor). This detector's own code path happens not to hit a jiterator
# op today, but the ceiling is a property of the wheel, not of the model —
# read that file's header before dropping the flag.
transformers==4.57.1
# torch 2.9.1, not 2.8.0: the cu128 build of 2.8.0 publishes no linux_aarch64
# wheel (manylinux x86_64 + win_amd64 only) and its required triton==3.4.0 has
# none either, so the sidecar cannot provision on an aarch64 CUDA host (GB10 /
# DGX Spark, Jetson Thor). 2.9.1+cu128 ships manylinux_2_28_aarch64 and pulls
# triton 3.5.1, which does too. See docs/reference/aarch64-support.md.
torch==2.9.1
torchvision==0.24.1
accelerate
bitsandbytes
peft
# decord is NOT optional: the checkpoint's trust_remote_code
# `processing_locateanything.py` has a bare top-level `import decord`, and
# transformers' `check_imports` scan rejects the module before it is even
# exec'd. Dropping it is not an option — verified live, the sidecar dies in
# `AutoProcessor.from_pretrained` with "requires the following packages that
# were not found in your environment: decord".
#
# But `decord` itself publishes x86_64/win wheels only; no aarch64 build has
# ever shipped, and it was the last thing blocking this sidecar on GB10 / Jetson
# Thor. `decord2` (Apache-2.0, github.com/johnnynunez/decord2) is the maintained
# fork that does publish `manylinux_2_28_aarch64`, and it installs the SAME
# top-level `decord` package (its own `libdecord.so`), so the remote-code import
# resolves unchanged. Split by marker rather than swapped outright so the
# x86_64 venv stays byte-identical to the one this integration was validated on.
decord==0.6.0 ; platform_machine != "aarch64"
decord2==3.4.0 ; platform_machine == "aarch64"
lmdb
opencv-python-headless==4.11.0.86
einops
safetensors==0.6.2
pillow
pyzmq
msgpack
requests==2.32.5
urllib3==2.5.0
